# CVeditör ortam değişkenleri: örnek dosya.
#
# Gerçek değerleri .env dosyasına yaz; .env git dışındadır (.gitignore).
# Bu dosyaya değer yazma, yalnız adları ve açıklamaları belgeler.

# ---------------------------------------------------------------- İstemci derlemesi (gizli DEĞİL)
# VITE_ önekli değişkenler istemci paketine gömülür: buraya asla sır yazılmaz.

# Yapay zekâ sağlayıcısı: "http" → aynı kökteki /api/ai/* uçları (src/ai/httpProvider.ts);
# boş ya da "mock" → örnek sağlayıcı (hiçbir yere istek atmaz).
# VITE_AI_PROVIDER=http

# ---------------------------------------------------------------- Sunucu (YALNIZ sunucu tarafında)
# Aşağıdakiler tarayıcıya asla gitmez; hiçbiri VITE_ önekiyle başlamaz.
# Hiçbiri zorunlu değil: boş bırakılanlar varsayılanla çalışır (yazılan değerler varsayılandır).

# Dinlenen port ve adres. Docker'da docker-compose.yml verir.
# PORT=8787
# HOST=0.0.0.0

# Önünde ters vekil (Caddy) varsa 1: istemcinin adresi X-Forwarded-For'un son öğesinden okunur
# (IP başına hız sınırı için). Vekil yokken 1 yapma: başlık uydurulabilir. docker-compose.yml 1 verir.
# TRUST_PROXY=0

# Sitenin dış adresi (ör. https://alan.adi). Verilirse POST isteklerinin Origin'i bununla
# karşılaştırılır; verilmezse isteğin Host başlığıyla.
# PUBLIC_ORIGIN=

# Statik site (derlenmiş istemci) ve yazı tipleri. Göreli yollar çalışma klasörüne göredir.
# SERVE_STATIC=0 → yalnız API (geliştirmede istemciyi Vite sunar; `npm run dev:server`).
# STATIC_DIR=dist
# FONTS_DIR=dist/fonts
# SERVE_STATIC=1

# ---------------------------------------------------------------- Tek tuşla PDF (/api/pdf)
# Aynı anda basılan PDF sayısı (her biri bir Chromium sekmesi, ~100-200 MB).
# PDF_CONCURRENCY=2
# Sırada bekleyebilecek en çok istek; fazlası 503 + Retry-After.
# PDF_QUEUE_LIMIT=8
# Tek PDF'in süre sınırı (ms; sırada bekleme hariç). Aşılınca 504.
# PDF_TIMEOUT_MS=30000
# İstek gövdesi üst sınırı (bayt; CV + fotoğraf). Aşılınca 413.
# PDF_MAX_BODY_BYTES=6291456
# IP başına dakikada en çok PDF isteği. Aşılınca 429 + Retry-After.
# PDF_RATE_LIMIT_PER_MINUTE=12

# ---------------------------------------------------------------- Yapay zekâ uçları (/api/ai/*)
# AI_ENDPOINT_PASSWORD, AI_SESSION_SECRET ve AI_DAILY_COST_CAP_USD üçü de verilmedikçe
# uçlar kapalıdır (503 not_configured). Bağlama adımları: docs/YAPAY-ZEKA.md

# Yapay zekâ sağlayıcısının API anahtarı.
# AI_API_KEY=

# Kullanılacak model kimliği.
# AI_MODEL=

# Yapay zekâ uçlarını koruyan parola. İstemci onu YALNIZ bir kez POST /api/ai/auth
# gövdesinde ({ "password": "…" }) gönderir; sunucu sabit zamanlı karşılaştırır,
# doğruysa 204 + oturum çerezi döner, yanlışsa 401. Parola tarayıcıda saklanmaz.
# AI_ENDPOINT_PASSWORD=

# Oturum çerezini imzalayan sır (HMAC; en az 32 rastgele bayt, ör. `openssl rand -base64 48`).
# Çerez: HttpOnly; Secure; SameSite=Strict; Path=/api/ai. Sır değişince bütün oturumlar düşer.
# AI_SESSION_SECRET=

# Oturum çerezinin geçerlilik süresi (saat). Süre dolunca uçlar 401 döner, arayüz parolayı yeniden sorar.
# AI_SESSION_TTL_HOURS=12

# İstek sınırı: oturum (ya da IP) başına dakikada en çok istek. Aşılınca 429 + Retry-After (saniye).
# AI_RATE_LIMIT_PER_MINUTE=10

# Günlük harcama tavanı (ABD doları). Aşılınca uçlar 503 (+ Retry-After) döner.
# AI_DAILY_COST_CAP_USD=

# İstek gövdesi üst sınırı (bayt). İstemcinin sınırı src/ai/types.ts AI_LIMITS.requestChars
# (200 000 karakter); UTF-8'de en çok ~4 katı bayt olabilir. Aşılınca 413.
# AI_MAX_BODY_BYTES=800000

# Model çağrısının süre sınırı (ms). İstemci uç başına 15-120 sn bekler (src/ai/httpProvider.ts HTTP_TIMEOUTS);
# sunucu sınırı bundan kısa olmalı. Aşılınca 504.
# AI_UPSTREAM_TIMEOUT_MS=90000

# Parola deneme sınırı: IP başına 15 dakikada en çok deneme. Aşılınca 429 + Retry-After.
# AI_AUTH_ATTEMPTS_PER_15_MIN=5
